# @hookform/resolvers declares ~25 optional peerDependencies (one per
# supported validator library). npm's default peer-auto-install tries to
# satisfy all of them at once and produces a lockfile that `npm install`
# accepts but `npm ci` rejects as inconsistent (conflicting ajv versions).
# We only use zod, which is a direct dependency already — none of those
# optional peers need to be installed.
legacy-peer-deps=true
