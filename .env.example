# Kopieren nach .env.local und mit den Werten aus dem Supabase-Dashboard (Project Settings → API) füllen.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Nur auf dem Server und in lokalen Skripten. Nie mit NEXT_PUBLIC_ benennen, nie in den Browser-Code, nie in einen Chat.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
